# Quote form email (api/quote.js). Add these in Vercel: Project → Settings → Environment Variables
# (Production), then redeploy. Open /api/quote in a browser afterwards: it reports whether mail is configured.
# Never commit real values; .env.local is git-ignored.

# The frigofood.ro mailbox lives on the cPanel server of Comtel Networks. Its certificate covers *.frigofood.ro.
SMTP_HOST=mail.frigofood.ro
# 465 = SSL (recommended here), 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=office@frigofood.ro
# Mailbox password (cPanel → Email Accounts). Set it in Vercel only.
SMTP_PASS=

# Optional. Who receives the requests; several addresses separated by commas.
QUOTE_TO=office@frigofood.ro
# Optional. Sender address; must be a mailbox on the same server or SPF will fail. Defaults to SMTP_USER.
QUOTE_FROM=office@frigofood.ro
# Optional. 1 = build the email but do not send it (used by `npm run check`).
QUOTE_DRY_RUN=0
